	partition Inventario = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaSilver & "andinalog_inventory_tracking_silver.csv"), [Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipado = Table.TransformColumnTypes(Encabezados, {{"movimiento_id", type text}, {"lote_id", type text}, {"producto_id", type text}, {"centro_distribucion", type text}, {"fecha_ingreso", type datetime}, {"fecha_salida", type datetime}, {"fecha_vencimiento", type datetime}, {"cantidad_ingreso", Int64.Type}, {"cantidad_salida", Int64.Type}, {"cantidad_merma", Int64.Type}, {"dias_en_almacen", Int64.Type}, {"costo_unitario_bob", type number}})
				in
				    Tipado

