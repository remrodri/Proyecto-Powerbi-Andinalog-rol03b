		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	partition Flota = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaSilver & "andinalog_flota_silver.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipado = Table.TransformColumnTypes(Encabezados, {{"camion_id", type text}, {"centro_distribucion_base", type text}, {"capacidad_kg", Int64.Type}, {"tipo_camion", type text}, {"antiguedad_anios", Int64.Type}, {"fecha_ultimo_mantenimiento", type date}})
				in
				    Tipado

