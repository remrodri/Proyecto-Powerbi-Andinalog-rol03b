	partition Productos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaSilver & "andinalog_productos_silver.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipado = Table.TransformColumnTypes(Encabezados, {{"producto_id", type text}, {"nombre_producto", type text}, {"categoria_logistica", type text}, {"temperatura_conservacion_requerida_c", Int64.Type}, {"tolerancia_temperatura_c", Int64.Type}, {"costo_unitario_bob", type number}, {"precio_unitario_bob", type number}})
				in
				    Tipado

